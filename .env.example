# ─────────────────────────────────────────────
#  BACKEND — copy to backend/.env
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dispatch_portal

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_secret
REFRESH_TOKEN_EXPIRE=7d

# Cookies
COOKIE_SECRET=change_me_cookie_secret

# Email (stub — leave blank to use console.log)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@dispatch.news

# File Uploads (local disk for dev)
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads

# AWS S3 (optional — leave blank to use local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
#  FRONTEND — copy to frontend/.env
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME=Dispatch
